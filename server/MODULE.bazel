module(
    name = "root",
    version = "1.0-SNAPSHOT",
)

# Add Bazel dependencies
bazel_dep(name = "rules_jvm_external", version = "6.2")
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# Define your Maven dependencies here
maven.install(
    artifacts = [
        "org.projectlombok:lombok:1.18.30",
                "com.google.guava:guava:32.0.1-jre",
                "com.google.code.gson:gson:2.8.9",
                "ch.qos.logback:logback-classic:1.3.14",
                "org.eclipse.lsp4j:org.eclipse.lsp4j:0.14.0",
                "org.apache.commons:commons-lang3:3.12.0",
                "org.junit.jupiter:junit-jupiter-engine:5.6.0",
                "org.junit.jupiter:junit-jupiter-params:5.6.0",
                "org.junit.platform:junit-platform-runner:1.6.0",
                "org.mockito:mockito-core:4.6.1",
                "org.mockito:mockito-junit-jupiter:4.6.1",
                "com.google.code.findbugs:jsr305:3.0.2",
                "org.slf4j:slf4j-api:2.0.7",
                "org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc:0.14.0",
                "org.antlr:antlr4:4.7.1",
                "org.antlr:antlr4:jar:complete:4.7.1",
                "org.antlr:antlr4-runtime:4.7.1",
                "org.antlr:stringtemplate:4.0.2",
                "info.picocli:picocli:4.7.5",
                "com.google.inject:guice:4.2.2",
                "com.google.inject.extensions:guice-assistedinject:4.2.2",
                "commons-io:commons-io:2.10.0",
                "org.apache.commons:commons-text:1.10.0",
        # Add any additional dependencies here
    ],
)

use_repo(maven, "maven")
