load("@rules_jvm_external//:defs.bzl", "artifact")
package(default_visibility = ["//visibility:public"])

# Generate Java sources from ANTLR grammar files on GIT BASH
genrule(
    name = "generate_antlr_sources",
    srcs = glob(["src/main/antlr4/**/CobolLexer.g4", "src/main/antlr4/**/CobolParser.g4"]),  # Path to ANTLR grammar files
    tools = ["@maven//:org_antlr_antlr4_complete_4_7_1"],
    cmd = "java -cp $(locations @maven//:org_antlr_antlr4_complete_4_7_1) org.antlr.v4.Tool -Dlanguage=Java -visitor -o $(GENDIR)/parser -package org.eclipse.lsp.cobol.core -lib $(GENDIR) $(SRCS)",
    outs = [
            "CobolLexer.interp",
                "CobolLexer.java",
                "CobolLexer.tokens",
                "CobolParser.interp",
                "CobolParser.java",
                "CobolParser.tokens",
                "CobolParserBaseListener.java",
                "CobolParserBaseVisitor.java",
                "CobolParserListener.java",
                "CobolParserVisitor.java"
                ],
)

