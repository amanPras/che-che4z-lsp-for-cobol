# Main java_library for the parser module
java_library(
    name = "parser",
    srcs = glob(["src/main/java/**/*.java"]) + [
        ":generate_antlr_sources",
    ],
    deps = [
        artifact("org.antlr:antlr4-runtime"),  # Add ANTLR runtime dependency
        ":lombok",
        "//common:common",                    # Dependency on the common module
        artifact("com.google.guava:guava"),
        artifact("org.antlr:antlr4"),
        artifact("org.eclipse.lsp4j:org.eclipse.lsp4j"),
    ],
    visibility = ["//visibility:public"],
)

java_plugin(
    name = "lombok_plugin",
    generates_api = True,
    processor_class = "lombok.launch.AnnotationProcessorHider$AnnotationProcessor",
    deps = ["@maven//:org_projectlombok_lombok"],
)

java_library(
    name = "lombok",
    exported_plugins = [
        ":lombok_plugin",
    ],
    visibility = ["//visibility:public"],
    exports = [
        "@maven//:org_projectlombok_lombok",
    ],
)
